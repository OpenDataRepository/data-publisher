# Configuration for the Puppeteer background-services workers. Copy this
# file to `.env` in the same directory and fill in real values. `.env` is
# gitignored; every worker loads it automatically (non-overriding).

# --- Chromium / Puppeteer (shared by ALL workers via chromium_launcher.js) ---
# Browser selection and --no-sandbox are auto-detected per host; you normally
# set nothing here. See DEV_SETUP_ARM.md.
#
# Accept invalid/self-signed TLS certs. DEV ONLY — dev boxes often serve
# odr.io with a self-signed/staging cert. Leave unset on production.
# ODR_CHROME_IGNORE_CERT=1
#
# Force the sandbox flag: 1 = always --no-sandbox, 0 = never. Unset = auto.
# ODR_CHROME_NO_SANDBOX=1
#
# Force a specific Chromium binary, bypassing auto-detection.
# PUPPETEER_EXECUTABLE_PATH=/home/you/.cache/ms-playwright/chromium-1234/chrome-linux/chrome

# --- static_render_daemon.js ---

# Public-API credentials used by static_render_daemon.js to fetch the
# JSON representation of each rendered record. The account must:
#   - Be permitted to authenticate via /api/v5/token (JSON login).
#   - Have read access to whichever records you want JSON snapshots of.
#     A user with public-only access is sufficient because the static
#     cache is for public consumption anyway.
#
# If either value is empty (or missing entirely) the daemon still renders
# HTML normally, just without the .json companion file.
ODR_API_USERNAME=
ODR_API_PASSWORD=

# Optional. Set to "1" to disable JSON fetching entirely without
# clearing the credentials above. Useful for local dev runs where you
# don't need the JSON snapshots.
# STATIC_RENDER_SKIP_JSON=0

# Optional toggles (already supported by the daemon, listed here so the
# operator sees them all in one place):
#
# Number of parallel render slots. Default 1; capped at 16. Each slot
# opens its own beanstalkd connection and Puppeteer page; they share
# the single browser.
# STATIC_RENDER_CONCURRENCY=1
#
# Force a specific Chromium binary. Otherwise the daemon probes
# common paths (Playwright cache, system chromium, etc.).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
#
# Skip HTTPS certificate validation when the target host uses a
# self-signed cert. DEV ONLY.
# STATIC_RENDER_IGNORE_HTTPS_ERRORS=1
#
# Grace period (ms) after window.__odrRenderReady fires, before
# capturing HTML. Covers tail-end lazy image decode. Default 500.
# STATIC_RENDER_POST_READY_MS=500
#
# Set to 1 to log a per-render breakdown of pending requests + a
# tally of repeated URLs at capture time. Verbose; turn on only when
# diagnosing slow renders.
# STATIC_RENDER_DEBUG_NET=1

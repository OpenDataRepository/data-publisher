{% apply spaceless %}

{% set top_level_datatype = import_targets['lookup'][top_level_datatype_id] %}

<div class="header">
    <h2>CSV Import for "<span id="target_datatype_name">{{ top_level_datatype.shortname }}</span>"</h2>
</div>

<div id="FullCSVImportForm">
{% if presets != null %}
    <div class="ODRAccordionWrapper ODRFormAccordion ODRCSVImportHeader Pointer">
        <h3 class="ui-accordion-header ui-helper-reset ui-state-default ui-state-active" role="tab" aria-expanded="true" aria-selected="true" tabindex="0">
            <span class="FRight"><i class="fa fa-lg fa-caret-up"></i></span>
            <a>Field Layout</a>
        </h3>
    </div>
{% endif %}

    <div class="content" style="margin: 10px;">
        <button id="ODRCSVImport_cancel" class="pure-button" onclick="ODRCSVImport_cancelCSVUpload();">Cancel CSV Import...</button>
        </br></br>

        <form id="csvUploadForm" class="pure-form pure-form-aligned">
            <input type="hidden" name="_token" value="{{ csrf_token(token_key) }}" />

            <fieldset>
                <div class="pure-control-group">
                    <label for="target_datatype" class="ODRCSVImport_selectlabel">Datatype to import into:</label>
                    <select name="target_datatype" id="target_datatype" {% if upload_type == '' %}disabled{% endif %}>
                    {% for prefix,data in import_targets['prefixes'] %}
                        {% set dt_id = data['id'] %}
                        {% set dt = import_targets['lookup'][dt_id] %}
                        {% if datatree_array['multiple_allowed'][dt_id] is defined %}
                            {% set multiple_allowed = true %}
                        {% endif %}

                        {% set warn = data['warn'] %}

                        {% if data['type'] == 'top-level' %}
                        <option class="ODRCSVImport_toplevel{% if warn %} ODRCSVImport_warn{% endif %}" value="{{ prefix }}">{{ dt.shortname }}</option>
                        {% elseif data['type'] == 'child' %}
                        <option class="ODRCSVImport_child{% if warn %} ODRCSVImport_warn{% endif %}{% if multiple_allowed %} multiple{% else %} single{% endif %}" value="{{ prefix }}">|-- {{ dt.shortname }} (child)</option>
                        {% elseif data['type'] == 'link' %}
                        <option class="ODRCSVImport_link{% if warn %} ODRCSVImport_warn{% endif %}" value="{{ prefix }}">|-- {{ dt.shortname }} ({% if warn %}invalid {% endif %}link)</option>
                        {% elseif data['type'] == 'child-link' %}
                        <option class="ODRCSVImport_childlink{% if warn %} ODRCSVImport_warn{% endif %}" value="{{ prefix }}">|&nbsp;&nbsp;&nbsp;&nbsp;|-- {{ dt.shortname }} ({% if warn %}invalid {% endif %}link)</option>
                        {% endif %}
                    {% endfor %}
                    </select>

                    <span id="top_level_import_warning" class="ODRCSVImport_warning ODRHidden">
                        <span><i class="fa fa-lg fa-exclamation-triangle Cursor"></i></span>
                        <span>&nbsp;The top-level Datatype doesn't have an "External ID" Datafield...every row in the CSV file WILL become a new Datarecord.</span>
                    </span>
                    <span id="top_level_link_warning" class="ODRCSVImport_warning ODRHidden">
                        <span><i class="fa fa-lg fa-exclamation-triangle Cursor"></i></span>
                        <span>&nbsp;This top-level Datatype doesn't have an "External ID" Datafield...CSV Importing can't continue because it's impossible to determine which Datarecords to link to.</span>
                    </span>

                    <span id="childtype_single_import_warning" class="ODRCSVImport_warning ODRHidden">
                        <span><i class="fa fa-lg fa-exclamation-triangle Cursor"></i></span>
                        <span>&nbsp;This child Datatype doesn't have an "External ID" Datafield...if a parent Datarecord in the CSV file already has a child Datarecord, then the contents of the child Datarecord WILL be overwritten.</span>
                    </span>

                    <span id="childtype_multiple_import_warning" class="ODRCSVImport_warning ODRHidden">
                        <span><i class="fa fa-lg fa-exclamation-triangle Cursor"></i></span>
                        <span>&nbsp;This child Datatype doesn't have an "External ID" Datafield...every row in the CSV file WILL become a new child Datarecord.</span>
                    </span>

                    <span id="invalid_linked_datatype_warning" class="ODRCSVImport_warning ODRHidden">
                        <span><i class="fa fa-lg fa-exclamation-triangle Cursor"></i></span>
                        <span>&nbsp;CSV Importing can't continue because it's impossible to determine which Datarecords to link to.</span>
                    </span>
                </div>

                <div class="pure-control-group">
                    <label for="delimiter_select" class="ODRCSVImport_selectlabel">Delimiter for CSV File:</label>
                    <select id="delimiter_select" {% if upload_type == '' %}disabled{% endif %}>
                        <option rel="">Select a delimiter...</option>
                        <option rel=",">{comma}</option>
                        <option rel="tab">{tab}</option>
                        <option rel="">{other}</option>
                    </select>
                    &nbsp;
                    <input type="text" name="csv_delimiter" id="delimiter_field" class="ODRDelimiterField ODRHidden" maxlength="1" size="3" />
                </div>
            </fieldset>

        {% if upload_type == 'csv' %}
            <div id="file_upload_div" class="ODRHidden">
            {% include '@ODRAdmin/Flow/flow_upload.html.twig' with {
                'target': 'csv_import',
                'single_file': true,
                'upload_type': 'csv',
                'datatype_id': top_level_datatype.id,
                'datarecord_id': 0,
                'datafield_id': 0,
                'callback': 'ODRCSVImport_loadLayout();',
                'display_loading_spinner': true,
            } %}
            </div>
        {% endif %}
        </form>

        <div id="layout_content">
        {% if presets != null %}
            {% include '@ODRAdmin/CSVImport/layout.html.twig' with {
                'columns': columns,
                'datatype': top_level_datatype,
                'datafields': datafields,
                'datatree_array': datatree_array,
                'fieldtypes': fieldtypes,
                'allowed_fieldtypes': allowed_fieldtypes,
                'presets': presets,
                'file_encoding_converted': file_encoding_converted,
                'tracked_job_id': tracked_job_id
            } %}
        {% endif %}
        </div>
    </div>

{% if presets != null and resulting_tag_arrays|length > 0 %}
    <div class="ODRAccordionWrapper ODRFormAccordion ODRCSVImportHeader Pointer" style="margin-top:15px;">
        <h3 class="ui-accordion-header ui-helper-reset ui-state-default ui-state-active" role="tab" aria-expanded="true" aria-selected="true" tabindex="0">
            <span class="FRight"><i class="fa fa-lg fa-caret-up"></i></span>
            <a>Resulting Tag structure</a>
        </h3>
    </div>
    <div class="content ODRContentWrapper" style="margin: 10px;">
        <div class="ODRThemeElement pure-u-1">
            <div class="ODRInnerBox">
            {% for col_num, stacked_tag_array in resulting_tag_arrays %}
                <div class="ODRDataField pure-u-1-2">
                    <fieldset>
                        <label id="Label_{{ col_num }}" class="ODRFieldLabel pure-u-1">
                            <span id="ODRDatafield_{{ col_num }}_name" style="margin-left:10px; font-weight: bold;">{{ columns[col_num] }}</span>
                        </label>
                        {% include '@ODRAdmin/Displaytemplate/tag_wrapper.html.twig' with {
                            'stacked_tags': stacked_tag_array,
                        } %}
                    </fieldset>
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
{% endif %}

{% if presets != null %}
    <div class="ODRCSVImportValidationResults ODRAccordionWrapper ODRFormAccordion ODRCSVImportHeader Pointer" style="margin-top:15px;">
        <h3 class="ui-accordion-header ui-helper-reset ui-state-default ui-state-active" role="tab" aria-expanded="true" aria-selected="true" tabindex="0">
            <span class="FRight"><i class="fa fa-lg fa-caret-up"></i></span>
            <a>Validation Results</a>
        </h3>
    </div>

    <div class="content" style="margin: 10px;">
    {% if errors != null and errors|length > 0 %}
        {% include '@ODRAdmin/CSVImport/errors.html.twig' with {'errors': errors} %}
    {% else %}
        <span>No errors found</span>
    {% endif %}
    </div>

    {% if allow_import == true %}
    <div>
        <button id="import_button" class="pure-button pure-button-primary" onclick="ODRCSVImport_beginImport();">Start Import</button>
    </div>
    {% endif %}
{% endif %}

 </div>

<div id="ImportLoadingBlock" class="ODRHidden">
    <div class="ODRRemodalLoading pure-u-1">
        <div class="JobStatusWrapper">
            <div class="JobComplete ODRHidden">Importing Complete</div>
            <div class="loading-container">
                <div class="loading"></div>
                <div class="loading-text">importing</div>
            </div>
        </div>
        <div class="JobTracker"></div>
        <div class="CSVExportMessage">Import will be completed momentarily. If you don't want
            to wait, feel free to continue to use the site and a message will inform you when your
            import is ready for the next step in the process.
        </div>
    </div>
</div>

<script>
    $(function() {
        disableSearchSidebar();    {# defined in @ODRAdmin/Default/common_js.html.twig #}

        if ( $(".ODRCSVImport_toplevel").hasClass('ODRCSVImport_warn') )
            $("#top_level_import_warning").removeClass('ODRHidden');

    {% if presets == null %}
        $("#delimiter_select").unbind('change').change(function() {
            var char = $(this).children(':selected').first().attr('rel');
            $("#delimiter_field").val(char);
            ODRCSVImport_delimiterChanged(char);
        });

        $("#delimiter_field").unbind('keyup paste').on('keyup paste', function() {
            var char = $(this).val();
            console.log('"' + char + '"');
            if ( char === ' ' ) {
                alert('space character is not a valid delimiter');
                $(this).val('');
            }

            ODRCSVImport_delimiterChanged(char);
        });

        $("#target_datatype").unbind('change').change(function() {
            // Hide all warnings...they'll get shown if required
            $(".ODRCSVImport_warning").addClass('ODRHidden');

            var top_level_has_warning = false;
            if ( $(".ODRCSVImport_toplevel").hasClass('ODRCSVImport_warn') )
                top_level_has_warning = true;

            var option = $(this).children(':selected');
            var type = 'top-level';
            if ( $(option).hasClass('ODRCSVImport_child') )
                type = 'child';
            else if ( $(option).hasClass('ODRCSVImport_link') || $(option).hasClass('ODRCSVImport_childlink') )
                type = 'link';

            if ( top_level_has_warning ) {
                // A top-level warning has two different outcomes
                if ( type == 'top-level' || type == 'child' )
                    $("#top_level_import_warning").removeClass('ODRHidden');
                else if ( type == 'link' )
                    $("#top_level_link_warning").removeClass('ODRHidden');
            }
            else if ( $(option).hasClass('ODRCSVImport_warn') ) {
                if ( type == 'child' ) {
                    // Child descendants without an external id field display warnings tailored to
                    //  whether they allow multiple child records or not
                    if ( $(option).hasClass('single') )
                        $("#childtype_single_import_warning").removeClass('ODRHidden');
                    else if ( $(option).hasClass('multiple') )
                        $("#childtype_multiple_import_warning").removeClass('ODRHidden');
                }
                else if ( type == 'link' ) {
                    // Linked descendants display their own error
                    $("#invalid_linked_datatype_warning").removeClass('ODRHidden');
                }
            }

            // Ensure file upload div shows/hides itself if an invalid link is selected
            $("#delimiter_select").trigger('change');
        });
    {% else %}
        $("#target_datatype").val("{{ presets.prefix }}");

        var selection = $("#target_datatype").find(':selected');
        var datatype_name = $(selection).text();
        if ( $(selection).hasClass('ODRCSVImport_child') || $(selection).hasClass('ODRCSVImport_link')  )
            datatype_name = datatype_name.slice(4);
        else if ( $(selection).hasClass('ODRCSVImport_childlink') )
            datatype_name = datatype_name.slice(9);
        $("#target_datatype_name").html(datatype_name);

        var delimiter = "{{ presets.csv_delimiter }}";
        if (delimiter === ',') {
            $("#delimiter_field").val(",");
            $("#delimiter_select").children('option').each(function() {
                if ( $(this).attr('rel') === ',')
                    $(this).prop('selected', true);
            });
        }
        else if (delimiter === "tab") {
            $("#delimiter_field").val("\t");
            $("#delimiter_select").children('option').each(function() {
                if ( $(this).attr('rel') === 'tab')
                    $(this).prop('selected', true);
            });
        }
        else {
            $("#delimiter_select").children('option').last().prop('selected', true);
            $("#delimiter_field").removeClass('ODRHidden');
        }


        $(".ODRCSVImportHeader").next().addClass('ODRHidden');
        $(".ODRCSVImportHeader").unbind('click').click(function() {
            if ( $(this).next().hasClass('ODRHidden') ) {
                $(this).next().removeClass('ODRHidden');

                $(this).find('i').removeClass('fa-caret-up').addClass('fa-caret-down');
            }
            else {
                $(this).next().addClass('ODRHidden');

                $(this).find('i').addClass('fa-caret-up').removeClass('fa-caret-down');
            }
        });

        $(".ODRCSVImportValidationResults").trigger('click');
        // $(".ODRCSVImportErrors").prev().trigger('click');    {# want tables to be hidden by default #}

        {% if resulting_tag_arrays|length > 0 %}
        setupTagTree();    {# defined in @ODRAdmin/Default/common_js.html.twig #}
        {% endif %}
    {% endif %}
    });


{% if upload_type == 'csv' %}
    /**
     * Uploading the initial file to CSVImport needs to trigger reading said file, and rendering a UI
     * to map colums from the file to fields in the database.
     */
    function ODRCSVImport_loadLayout() {

        url = '{{ path('odr_csv_import_layout') }}';

        var selection = $("#target_datatype").find(':selected');
        var datatype_name = $(selection).text();
        if ( $(selection).hasClass('ODRCSVImport_child') || $(selection).hasClass('ODRCSVImport_link')  )
            datatype_name = datatype_name.slice(4);
        else if ( $(selection).hasClass('ODRCSVImport_childlink') )
            datatype_name = datatype_name.slice(9);

        var post_data = $("#csvUploadForm").serialize();
//alert(url, post_data);  return;

        $.ajax({
            cache: false,
            type: 'POST',
            data: post_data,
            url: url,
            dataType: 'json',
            success: function(data, textStatus, jqXHR) {
                $("#csvUploadForm").remove();
                $("#layout_content").append( data.d.html );

                $("#target_datatype_name").html( datatype_name );
            },
            error: function(jqXHR, textStatus, errorThrown) {
                // Don't need to do anything specific on an error
            },
            complete: function(jqXHR, textStatus) {
                // Get rid of the loading overlay regardless of status
                hideSearchOverlay();

                // Get the xdebugToken from response headers
                var xdebugToken = jqXHR.getResponseHeader('X-Debug-Token');

                // If the Sfjs object exists
                if (typeof Sfjs !== "undefined") {
                    // Grab the toolbar element
                    var currentElement = $('.sf-toolbar')[0];

                    // Load the data of the given xdebug token into the current toolbar wrapper
                    Sfjs.load(currentElement.id, '/app_dev.php/_wdt/'+ xdebugToken);
                }
            }
        });
    }

    /**
     * CSVImport needs to have a delimiter selected before it'll allow uploads of files.
     *
     * @param {string} delimiter
     */
    function ODRCSVImport_delimiterChanged(delimiter) {
        // Don't display the file upload div when either link warning is active
        var active_link_warning = false;
        if ( !$("#top_level_link_warning").hasClass('ODRHidden') || !$("#invalid_linked_datatype_warning").hasClass('ODRHidden') )
            active_link_warning = true;

        if ( delimiter === "" || delimiter === " " || active_link_warning )
            $("#file_upload_div").addClass('ODRHidden');
        else
            $("#file_upload_div").removeClass('ODRHidden');

        if ( $("#delimiter_select").children(':selected').html() === '{other}' )
            $("#delimiter_field").removeClass('ODRHidden');
        else
            $("#delimiter_field").addClass('ODRHidden');
    }

{% endif %} {# if upload_type == 'csv' #}

    /**
     * Cancels a CSVImport attempt, regardless of whether it's been validated or not.
     */
    function ODRCSVImport_cancelCSVUpload() {
    {% if tracked_job_id is defined %}
        {# Delete existing tracked job when cancelling an import after validating it #}
        var delete_url = "{{ path('odr_delete_user_job', {'job_id': tracked_job_id} ) }}";

        $.ajax({
            type: 'GET',
            url: delete_url,
            dataType: 'json',
            success: function (data) {
            },
            complete: function (jqXHR) {
                // Get the xdebugToken from response headers
                var xdebugToken = jqXHR.getResponseHeader('X-Debug-Token');

                // If the Sfjs object exists
                if (typeof Sfjs !== "undefined") {
                    // Grab the toolbar element
                    var currentElement = $('.sf-toolbar')[0];

                    // Load the data of the given xdebug token into the current toolbar wrapper
                    Sfjs.load(currentElement.id, '/app_dev.php/_wdt/' + xdebugToken);
                }
            }
        });
    {% endif %}

        var url = '{{ path('odr_csv_cancel_import') }}';

        $.ajax({
            cache: false,
            type: 'GET',
            url: url,
            dataType: 'json',
            success: function(data, textStatus, jqXHR) {
            {% if import_type is not defined %}
                var url = '{{ path('odr_csv_import', {'datatype_id': top_level_datatype_id}) }}';
            {% elseif import_type == 'top-level' %}
                var url = '{{ path('odr_csv_import', {'datatype_id': target_datatype.id}) }}';
            {% elseif import_type == 'child' or import_type == 'link' %}
                var url = '{{ path('odr_csv_import', {'datatype_id': parent_datatype.id}) }}';
            {% else %}
                var url = '{{ path('odr_csv_import', {'datatype_id': grandparent_datatype.id}) }}';
            {% endif %}
                UpdateURL(url);
            },
            error: function(jqXHR, textStatus, errorThrown) {
                // Don't need to do anything specific on an error
            },
            complete: function(jqXHR, textStatus) {
                // Get the xdebugToken from response headers
                var xdebugToken = jqXHR.getResponseHeader('X-Debug-Token');

                // If the Sfjs object exists
                if (typeof Sfjs !== "undefined") {
                    // Grab the toolbar element
                    var currentElement = $('.sf-toolbar')[0];

                    // Load the data of the given xdebug token into the current toolbar wrapper
                    Sfjs.load(currentElement.id, '/app_dev.php/_wdt/'+ xdebugToken);
                }
            }
        });
    }

{% if allow_import == true %}
    /**
     * Triggers the actual CSVImport, after the validation results have been checked by the user.
     */
    function ODRCSVImport_beginImport() {
        var url = '{{ path('odr_csv_import_start_worker', {'job_id': tracked_job_id}) }}';

        // Attempt to prevent the browser from starting this import twice in a row...
        $("#import_button").attr('disabled', 'disabled');
        $("#import_button").html('Loading...');

        $.ajax({
            cache: false,
            type: 'GET',
            url: url,
            dataType: 'json',
            success: function(data) {
                // Replace this with loading message/checker directly
                $('#FullCSVImportForm').addClass('ODRHidden');
                $('#ImportLoadingBlock').removeClass('ODRHidden').fadeIn('fast');
                getJobProgress('csv_import', data.d.tracked_job_id);
            },
            error: function(jqXHR, textStatus, errorThrown) {
                // Don't need to do anything specific on an error
            },
            complete: function(jqXHR, textStatus) {
                // Get the xdebugToken from response headers
                var xdebugToken = jqXHR.getResponseHeader('X-Debug-Token');

                // If the Sfjs object exists
                if (typeof Sfjs !== "undefined") {
                    // Grab the toolbar element
                    var currentElement = $('.sf-toolbar')[0];

                    // Load the data of the given xdebug token into the current toolbar wrapper
                    Sfjs.load(currentElement.id, '/app_dev.php/_wdt/'+ xdebugToken);
                }
            }
        });
    }
{% endif %} {# if allow_import == true #}

</script>

{% endapply %}

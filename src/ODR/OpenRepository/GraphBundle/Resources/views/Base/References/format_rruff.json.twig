{# This special context instructs plugins to return both 'text' and 'html' contexts as an array, to prevent multiple calls #}
{% set rendering_options = {'context': 'text|html'} %}

{% set author_text = '' %}
{% set author_html = '' %}
{% if mapping.authors is defined %}
    {% set author = mapping.authors %}

    {% if mapping.authors.render_plugin_instance is defined %}
        {# NOTE - these datafield_plugin calls work because ReferencesPlugin.php finds the renderPluginInstance that actually renders something...it's not the original cached datafield array #}
        {% set author = mapping.authors.datafield|datafield_plugin(datarecord, mapping.authors.render_plugin_instance, rendering_options)|raw %}
    {% endif %}

    {% set author_text = author['text'] %}
    {% set author_html = author['html'] %}
{% endif %}

{% set year_text = '' %}
{% set year_html = '' %}
{% if mapping.year is defined %}
    {% set year = mapping.year %}

    {% if mapping.year.render_plugin_instance is defined %}
        {% set year = mapping.year.datafield|datafield_plugin(datarecord, mapping.year.render_plugin_instance, rendering_options)|raw %}
    {% endif %}

    {% set year_text = year['text'] %}
    {% set year_html = year['html'] %}
{% endif %}

{% set article_title_text = '' %}
{% set article_title_html = '' %}
{% if mapping.article_title is defined %}
    {% set article_title = mapping.article_title %}

    {% if mapping.article_title.render_plugin_instance is defined %}
        {% set article_title = mapping.article_title.datafield|datafield_plugin(datarecord, mapping.article_title.render_plugin_instance, rendering_options)|raw %}
    {% endif %}

    {% set article_title_text = article_title['text'] %}
    {% set article_title_html = article_title['html'] %}

    {% set needs_period = true %}
    {% if article_title_text|last == '.' or article_title_text|last == '?' or article_title_text|last == '!' %}
        {# do nothing #}
    {% elseif article_title_text != '' %}
        {% set article_title_text = article_title['text'] ~ '.' %}
        {% set article_title_html = article_title['html'] ~ '.' %}
    {% endif %}
{% endif %}


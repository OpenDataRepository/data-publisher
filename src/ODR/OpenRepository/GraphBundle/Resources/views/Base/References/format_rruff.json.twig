{% set url = [] %}
{% set url_using_render_plugin = false %}
{% if mapping.url is defined %}
    {% set url = mapping.url %}

    {% if mapping.url.render_plugin_instance is defined %}
        {% set url_using_render_plugin = true %}
        {% set url = mapping.url.datafield|datafield_plugin(datarecord, mapping.url.render_plugin_instance, rendering_options)|raw %}
    {% endif %}

    {% set url_text = url['text'] %}
    {% set url_html = url['html'] %}

    {% if url_using_render_plugin %}
        {# don't modify what the plugin did #}
        {% set url_text = url['text'] %}
        {% set url_html = url['html'] %}
    {% elseif 'doi.org' in url_text %}
        {# treat DOI urls different than other urls #}
        {% set url_text = url['text'] %}
        {% set initial_url = url['html'] %}
        {% if initial_url != '' %}
            {% set url_html = ';&nbsp;<a href="' ~ initial_url ~ '" title="Open URL" target="_blank">' ~ initial_url ~ '</a>' %}
        {% endif %}
    {% else %}
        {% set url_text = '' %}  {# TODO - don't keep regular URLs? #}
        {% set initial_url = url['html'] %}
        {% if initial_url != '' %}
            {% set url_html = '&nbsp;<a href="' ~ initial_url ~ '" title="Open URL" target="_blank">[<i class="fa fa-external-link"></i> URL]</a>' %}
        {% endif %}
    {% endif %}
{% endif %}

{% set file_html = '' %}
{% if mapping.file is defined and mapping.file|length > 0 %}
    {% for file_entry in mapping.file.datarecordfield.file %}    {# This plugin will only receive files the user is allowed to view #}
        {% set file_html = file_html ~ '&nbsp;<a href="' ~ path('odr_file_download', { 'file_id': file_entry.id } ) ~ '" class="ODRFileDownload" rel="' ~ file_entry.id ~ '">[view file]</a>' %}

        {# these spans are needed so the file downloading javascript doesn't crash...they aren't visible because they lack the classnames #}
        {% set file_html = file_html ~ '<span id="ODRFileDecrypt_' ~ file_entry.id ~ '_overlay" style="visibility:hidden;"><span id="ODRFileDecrypt_' ~ file_entry.id ~ '_progress"></span></span>' %}
    {% endfor %}
{% endif %}

{# "supporting files" is currently only used by chemin #}
{% set supporting_file_html = '' %}
{% if mapping.supporting_files is defined and mapping.supporting_files|length > 0 %}
    {% set file_num = 1 %}
    {% for file_entry in mapping.supporting_files.datarecordfield.file %}    {# This plugin will only receive files the user is allowed to view #}
        {% set supporting_file_html = supporting_file_html ~ '&nbsp;<a href="' ~ path('odr_file_download', { 'file_id': file_entry.id } ) ~ '" class="ODRFileDownload" rel="' ~ file_entry.id ~ '">[supporting file ' ~ file_num ~ ']</a>' %}
        {% set file_num = file_num + 1 %}

        {# these spans are needed so the file downloading javascript doesn't crash...they aren't visible because they lack the classnames #}
        {% set supporting_file_html = supporting_file_html ~ '<span id="ODRFileDecrypt_' ~ file_entry.id ~ '_overlay" style="visibility:hidden;"><span id="ODRFileDecrypt_' ~ file_entry.id ~ '_progress"></span></span>' %}
    {% endfor %}
{% endif %}

{# year and publisher_location should have surrounding parenthesis if they have an actual value #}
{% if year_text != '' %}
    {% set year_text = '(' ~ year_text ~ ')' %}
    {% set year_html = '(' ~ year_html ~ ')' %}
{% endif %}
{% if publisher_location_text != '' %}
    {% set publisher_location_text = '(' ~ publisher_location_text ~ ')' %}
    {% set publisher_location_html = '(' ~ publisher_location_html ~ ')' %}
{% endif %}
{# issue should only be displayed if it also has a volume...also, need a comma after volume/issue #}
{% if volume_text != '' %}
    {% if issue_text != '' %}
        {% set volume_text = volume_text ~ '(' ~ issue_text ~ '),' %}
        {% set volume_html = volume_html ~ '(' ~ issue_html ~ '),' %}
    {% else %}
        {% set volume_text = volume_text ~ ',' %}
        {% set volume_html = volume_html ~ ',' %}
    {% endif %}
{% endif %}
{# book title needs some extra stuff...also need a comma afterwards #}
{% if book_title_text != '' %}
    {% set book_title_text = 'in ' ~ book_title_text ~ ',' %}
    {% set book_title_html = 'in <i>' ~ book_title_html ~ '</i>,' %}
{% endif %}
{# text urls should have a little more explicit separation #}
{% if url_text != '' %}
    {% set url_text = '; ' ~ url_text %}
{% endif %}

{
    "text": "{{ author_text }} {{ year_text }} {{ article_title_text }} {{ journal_text }} {{ volume_text }} {{ book_title_text }} {{ publisher_text }} {{ publisher_location_text }} {{ pages_text }} {{ url_text }}",
    "html": "{{ author_html }} {{ year_html }} {{ article_title_html }} {{ journal_html }} {{ volume_html }} {{ book_title_html }} {{ publisher_html }} {{ publisher_location_html }} {{ pages_html }} {{ url_html }} {{ file_html }} {{ supporting_file_html }}"
}

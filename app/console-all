#!/usr/bin/env php
<?php
//
// console-all — run one app/console command against every linked ODR instance.
//
// The everyday console auto-detects a single instance from the current directory (see app/console).
// This is for the bulk case: after a deploy, clear cache or run migrations across ALL linked sites in
// one shot instead of cd-ing a dozen times. Invoke it the same way as the console:
//
//   php app/console-all cache:clear --env=prod
//   php app/console-all doctrine:migrations:migrate --no-interaction
//
// It reads instance roots from app/config/instances.list (one per line; '#' comments and blank lines
// ignored) and runs THIS checkout's app/console against each, passing ODR_INSTANCE so the child
// targets that instance's own app/config, var/cache and var/log. It continues past a failing site and
// exits non-zero if any instance failed.
//
// Copy app/config/instances.list.dist to app/config/instances.list and fill in your instance roots.
//
// Run with sudo, each instance's command runs as the user who owns that instance (the owner of its
// root directory), so the cache and logs it writes belong to that site:
//
//   sudo php app/console-all cache:clear --env=prod

$app_dir = __DIR__;                          // .../data-publisher/app
$console = $app_dir . '/console';
$list    = $app_dir . '/config/instances.list';

$args = array_slice($argv, 1);               // everything after the script name = console command+args

if (!is_file($list)) {
    fwrite(STDERR, "console-all: no instance list at $list\n");
    fwrite(STDERR, "  cp app/config/instances.list.dist app/config/instances.list  and add one instance root per line.\n");
    exit(1);
}
if (!$args) {
    fwrite(STDERR, "usage: php app/console-all <console command and args...>\n");
    fwrite(STDERR, "  e.g. php app/console-all cache:clear --env=prod\n");
    exit(2);
}

// parse the list: strip trailing '#' comments and surrounding whitespace, drop blank lines
$roots = [];
foreach (file($list, FILE_IGNORE_NEW_LINES) ?: [] as $raw) {
    $line = trim(preg_replace('/#.*$/', '', $raw));
    if ($line !== '')
        $roots[] = rtrim($line, '/');
}

// Who we are, and how to run a command as another user (only possible as root)
$is_root = function_exists('posix_geteuid') && posix_geteuid() === 0;
$me = function_exists('posix_geteuid') ? (posix_getpwuid(posix_geteuid())['name'] ?? null) : get_current_user();
$as_user = function ($user) {
    // runuser (util-linux) needs no password or sudoers entry; sudo elsewhere
    return is_executable('/usr/sbin/runuser') || is_executable('/sbin/runuser')
        ? ['runuser', '-u', $user, '--']
        : ['sudo', '-n', '-u', $user, '--'];
};
function instance_owner($root) {
    $uid = @fileowner($root);
    if ($uid === false)
        return null;
    if (!function_exists('posix_getpwuid'))
        return null;
    $pw = posix_getpwuid($uid);
    return $pw ? $pw['name'] : null;
}

$rc = 0;
$count = 0;
foreach ($roots as $root) {
    $count++;
    fwrite(STDOUT, sprintf("\n===== [%d] %s =====\n", $count, $root));

    if (!is_dir($root . '/app/config')) {
        fwrite(STDERR, "  SKIP: $root has no app/config (not an instance root?)\n");
        $rc = 1;
        continue;
    }

    // Run this checkout's console against the instance. ODR_INSTANCE makes the child target it
    // deterministically (see app/console resolution order); cwd is set to the instance too so any
    // relative paths in the command resolve there. stdio is inherited so output streams live.
    $env = getenv();                         // inherit the full environment...
    $env['ODR_INSTANCE'] = $root;            // ...but pin the target instance
    unset($env['ODR_APP_DIR']);              // and drop any stray override that would win over it

    // Run it as the user who owns the instance, so what it creates in var/cache and var/log is
    //  theirs -- an instance only has to be writable by its owner and the web server.  That needs
    //  root (sudo php app/console-all ...); otherwise it all runs as you.
    $cmd = array_merge([PHP_BINARY, $console], $args);
    $owner = instance_owner($root);
    if ($is_root && $owner !== null && $owner !== 'root') {
        fwrite(STDOUT, "  running as $owner\n");
        // env pins ODR_INSTANCE whatever runuser/sudo do to the environment
        $cmd = array_merge($as_user($owner), ['env', 'ODR_INSTANCE=' . $root], $cmd);
    }
    elseif (!$is_root && $owner !== null && $owner !== $me) {
        fwrite(STDOUT, "  note: this instance belongs to $owner; you're $me -- if it can't write var/,"
            . " run this with sudo\n");
    }

    $proc = proc_open(
        $cmd,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $root,
        $env
    );
    if (!is_resource($proc)) {
        fwrite(STDERR, "  FAILED to launch php for $root\n");
        $rc = 1;
        continue;
    }
    $exit = proc_close($proc);
    if ($exit !== 0) {
        fwrite(STDERR, "  FAILED (exit $exit) for $root\n");
        $rc = 1;
    }
}

fwrite(STDOUT, sprintf("\n===== done: %d instance(s), overall %s =====\n",
    $count, $rc === 0 ? 'OK' : 'ERRORS — see above'));
exit($rc);

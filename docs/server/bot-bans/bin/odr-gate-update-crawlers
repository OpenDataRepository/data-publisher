#!/usr/bin/env python3
"""
ODR search gate: turns ODR's verified-crawler list into the Apache config odr-gate.conf reads.

The list (var/crawler_ips.json) is written by `php app/console odr:crawler_ips:update` as the
ODR user.  Apache's config is read as root, so this never includes that file: it reads it as
data, validates every range, collapses them, and writes its own config.  Run from root's cron
after the ODR command.

    odr-gate-update-crawlers /home/odr/data-publisher/var/crawler_ips.json
    odr-gate-update-crawlers --dry-run /home/odr/data-publisher/var/crawler_ips.json

Writes /etc/apache2/odr-gate-crawlers.conf.  When it changed, checks the whole Apache config
(apachectl configtest) before reloading, and puts the previous file back if the check fails.
"""

import ipaddress
import json
import os
import subprocess
import sys

OUTPUT = os.environ.get('ODR_GATE_CRAWLERS_CONF', '/etc/apache2/odr-gate-crawlers.conf')
MINIMUM = 20                     # fewer usable ranges than this means a broken list
NARROWEST_ALLOWED = {4: 8, 6: 16}   # refuse anything broader than /8 (IPv4) or /16 (IPv6)


def read_list(path):
    networks, rejected = [], []
    try:
        with open(path) as handle:
            data = json.load(handle)
        # each entry is [network, mask or bits, source, cidr]; only the cidr is used, and checked
        entries = list(data.get('ipv4', [])) + list(data.get('ipv6', []))
    except (OSError, ValueError, AttributeError, TypeError) as error:
        sys.exit('could not read %s as json: %s' % (path, error))
    for entry in entries:
        token = str(entry[3]) if isinstance(entry, list) and len(entry) >= 4 else repr(entry)
        try:
            network = ipaddress.ip_network(token, strict=False)
        except ValueError:
            rejected.append(token + ' (not a range)')
            continue
        if not network.is_global:
            rejected.append(token + ' (not a public range)')
        elif network.prefixlen < NARROWEST_ALLOWED[network.version]:
            rejected.append(token + ' (too broad)')
        else:
            networks.append(network)
    return networks, rejected


def render(networks):
    v4 = list(ipaddress.collapse_addresses(n for n in networks if n.version == 4))
    v6 = list(ipaddress.collapse_addresses(n for n in networks if n.version == 6))
    terms = ["-R '%s'" % n for n in v4 + v6]
    return ('# GENERATED by odr-gate-update-crawlers from ODR\'s verified-crawler list -- do not edit.\n'
            '# %d IPv4 + %d IPv6 ranges (Google, Bing, DuckDuckGo, Site24x7).  Sets odr_crawler=1 for a request\n'
            '# from one of them; odr-gate.conf lets those through without the challenge.\n'
            'SetEnvIfExpr "%s" odr_crawler=1\n') % (len(v4), len(v6), ' || '.join(terms)), len(v4), len(v6)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    dry_run = '--dry-run' in sys.argv
    if len(args) != 1:
        sys.exit(__doc__.strip().split('\n\n')[1])
    path = args[0]
    if not os.path.isfile(path):
        sys.exit('no list at %s -- run `php app/console odr:crawler_ips:update` first' % path)

    networks, rejected = read_list(path)
    for token in rejected:
        print('  skipped %s' % token)
    if len(networks) < MINIMUM:
        sys.exit('only %d usable ranges in %s -- refusing to replace the crawler config' % (len(networks), path))

    contents, n4, n6 = render(networks)
    previous = open(OUTPUT).read() if os.path.exists(OUTPUT) else None
    if contents == previous:
        print('%s is already current (%d IPv4 + %d IPv6 ranges)' % (OUTPUT, n4, n6))
        return
    print('%s: %d IPv4 + %d IPv6 ranges%s' % (OUTPUT, n4, n6, '' if previous else ' (new file)'))
    if dry_run:
        print('--dry-run given, nothing written')
        return

    temp = OUTPUT + '.new'
    with open(temp, 'w') as handle:
        handle.write(contents)
    os.chmod(temp, 0o644)
    os.replace(temp, OUTPUT)

    test = subprocess.run(os.environ.get('ODR_GATE_APACHECTL', 'apachectl configtest').split(), capture_output=True, text=True)
    if test.returncode != 0:
        if previous is None:
            os.remove(OUTPUT)
        else:
            with open(OUTPUT, 'w') as handle:
                handle.write(previous)
        sys.exit('apachectl configtest failed, previous crawler config restored:\n' + (test.stderr or test.stdout))

    if os.environ.get('ODR_GATE_NO_RELOAD'):
        print('ODR_GATE_NO_RELOAD set, not reloading Apache')
        return
    subprocess.run(['systemctl', 'reload', 'apache2'], check=True)
    print('Apache reloaded')


if __name__ == '__main__':
    main()

# ODR bot bans.  See BAN_SYSTEM.md.
#
# Every jail drops the banned address at the firewall (nftables) for web traffic only --
# ports 80 and 443 -- so a mistaken ban can never lock anyone out of ssh.  Drop rather than
# reject: under a flood, answering every refused packet is work we don't need to do.

[DEFAULT]
# Addresses never banned by these jails: this server, and wherever the people testing the
# search gate sit.  Ten unsolved challenges in 24 hours bans the office otherwise.
# ADD YOUR OFFICE / VPN ADDRESSES HERE (space separated, CIDR allowed).
odr_ignoreip = 127.0.0.1/8 ::1

# The access logs written with the combined_gate LogFormat: every site using the gate.  A wildcard
# picks up a new site's log on the next fail2ban reload; or list them, one per line, indented.
# Bans are server-wide (they're at the firewall): abuse on one site blocks the address from all.
odr_logpath = /var/log/apache2/*-access.log

odr_banaction = nftables[type=multiport, blocktype=drop]
odr_port = http,https


# Anything that got a 410: the Bustamite?sample_child_id flood (gate=attack) and banned bots
# (gate=banned-bot).  Apache sends those before PHP runs.  One is enough.  An approved crawler's
# 410 (gate=approved_410) isn't counted.
[odr-410]
enabled   = true
filter    = odr-410
logpath   = %(odr_logpath)s
backend   = auto
ignoreip  = %(odr_ignoreip)s
banaction = %(odr_banaction)s
port      = %(odr_port)s
maxretry  = 1
findtime  = 1h
bantime   = 48h

# 10 minimal 404s (urls that aren't a valid search) within 24 hours.  An approved crawler's are
# logged gate=approved_404 instead, and aren't counted: it gets the 404 but isn't banned.
[odr-minimal404]
enabled   = true
filter    = odr-minimal404
logpath   = %(odr_logpath)s
backend   = auto
ignoreip  = %(odr_ignoreip)s
banaction = %(odr_banaction)s
port      = %(odr_port)s
maxretry  = 10
findtime  = 24h
bantime   = 48h

# 10 reCAPTCHA challenges served within 24 hours, i.e. asking and never answering.  Every page
# a visitor without a pass asks for is a challenge, until they solve one.
[odr-challenge]
enabled   = true
filter    = odr-challenge
logpath   = %(odr_logpath)s
backend   = auto
ignoreip  = %(odr_ignoreip)s
banaction = %(odr_banaction)s
port      = %(odr_port)s
maxretry  = 10
findtime  = 24h
bantime   = 48h

# Published ip lists of banned bots (Amazonbot, ...), loaded by odr-ban-bot-ips rather than
# found in a log.  Longer than the refresh interval so a listed address never lapses; one that
# drops off the published list expires on its own.
[odr-bots]
enabled   = true
filter    = odr-manual
logpath   = /dev/null
backend   = polling
ignoreip  = %(odr_ignoreip)s
banaction = %(odr_banaction)s
port      = %(odr_port)s
maxretry  = 1
bantime   = 3d
